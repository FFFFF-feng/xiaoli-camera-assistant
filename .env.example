# 默认 true：无需模型 API 也能完整演示流程。
APP_DEMO_MODE=true

# 切换真实多模态模型时填写兼容 OpenAI Chat Completions 的接口。
CAMERA_AI_API_KEY=
CAMERA_AI_BASE_URL=https://api.openai.com/v1
CAMERA_AI_VISION_MODEL=
CAMERA_AI_TEXT_MODEL=

# 可选配置
CAMERA_AI_TIMEOUT_SECONDS=60
CAMERA_AI_MAX_IMAGE_MB=15

# legacy：保留原有演示资料；managed：只检索 SQLite 中审核后发布的资料。
# 不会自动将现有知识内容导入或判定为已审核。
KNOWLEDGE_RETRIEVAL_MODE=legacy
KNOWLEDGE_DB_PATH=data/knowledge.db
