# 默认 true：无需模型 API 也能完整演示流程。
APP_DEMO_MODE=true

# 真实环境组合：APP_DEMO_MODE=false + CAMERA_AI_PRESET=glm-dino。
# preset 默认 GLM-4.6V + Grounding DINO Tiny，开启构图和检测。
# API Key 优先 CAMERA_AI_API_KEY，其次 ZHIPU_API_KEY，最后复用本机实验窗口的加密智谱密钥。
CAMERA_AI_PRESET=custom

# 独立视觉测试工具：默认模拟，无密钥可启动；真实模型在页面编辑。
# 只填本地密钥，不提交 .env。不必配置所有服务。
DASHSCOPE_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 可选：默认 data/vision_lab，目录不提交 Git。
# VISION_LAB_DATA_DIR=data/vision_lab

# 切换真实多模态模型时填写兼容 OpenAI Chat Completions 的接口。
CAMERA_AI_API_KEY=
CAMERA_AI_BASE_URL=
CAMERA_AI_VISION_MODEL=
CAMERA_AI_TEXT_MODEL=

# 可选配置
CAMERA_AI_TIMEOUT_SECONDS=60
CAMERA_AI_MAX_IMAGE_MB=15
CAMERA_AI_MAX_OUTPUT_TOKENS=4096
# 输出约束：custom 默认 prompt，glm-dino 默认 json_object。
# 仅当接口支持时选择 json_object；不支持时显式配置 prompt，不会自动降级。
# CAMERA_AI_RESPONSE_FORMAT=json_object
# 仅为模型内容的非法 JSON 重试，允许 0 或 1；服务错误、拒绝及截断不重试。
CAMERA_AI_FORMAT_RETRY_COUNT=1
# 实测配置保留服务默认思考模式；可显式关闭。
CAMERA_AI_DISABLE_THINKING=false
# 网页/手机：增量接收进度和已校验部分，线稿仍待完整构图数据校验。
# 服务不支持流式时可关闭；失败不自动重发付费请求。
CAMERA_AI_STREAM_OUTPUT=true
# 构图与参数生成并行，接口并发额度有限时可关闭。
CAMERA_AI_PARALLEL_ADVICE=true
# 检测启用时，提前加载相同本地模型，与视觉识别重叠；不额外推理。
CAMERA_AI_DETECTOR_WARMUP=true

# 可选参考图驱动图片编辑：默认关闭；必须独立配置，不复用识别模型密钥。
# 当前适配 OpenAI-compatible multipart POST /images/edits，响应须含 data[0].b64_json。
# 未配置不会调用；仅用户单独确认并点击生成时发送所选参考图。
CAMERA_IMAGE_EDIT_ENABLED=false
CAMERA_IMAGE_EDIT_BASE_URL=
CAMERA_IMAGE_EDIT_API_KEY=
CAMERA_IMAGE_EDIT_MODEL=
CAMERA_IMAGE_EDIT_TIMEOUT_SECONDS=180
# 不同模型支持不同参数；不支持或始终高保真的模型用 omit。
CAMERA_IMAGE_EDIT_INPUT_FIDELITY=omit
CAMERA_IMAGE_EDIT_QUALITY=medium
# 以下留空行不启用任何行为，按需要取消注释；glm-dino 默认两项为 true。
# CAMERA_AI_COMPOSITION_ENABLED=true
# CAMERA_AI_DETECTOR_ENABLED=true
# CAMERA_AI_DETECTOR_DEVICE=cpu
# CAMERA_AI_DETECTOR_BOX_THRESHOLD=0.35
# CAMERA_AI_DETECTOR_TEXT_THRESHOLD=0.25
# CAMERA_AI_DETECTOR_TIMEOUT_SECONDS=180
# CAMERA_AI_DETECTOR_WEIGHTS_PATH=data/vision_lab/model_cache/grounding-dino-tiny
# CAMERA_AI_DETECTOR_PYTHON=.venv-detectors/Scripts/python.exe
# glm-dino 预设固定本次实验权重 revision；换权重时显式填写新清单 revision。
# CAMERA_AI_DETECTOR_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71

# legacy：保留原有演示资料；managed：只检索 SQLite 中审核后发布的资料。
# 不会自动将现有知识内容导入或判定为已审核。
KNOWLEDGE_RETRIEVAL_MODE=legacy
KNOWLEDGE_DB_PATH=data/knowledge.db

# 手机 App 连接令牌（至少 24 字符），不是云模型 API Key。
# 留空时 scripts/start_mobile_api.py 在 .launcher/mobile-access.json 自动生成。
MOBILE_API_TOKEN=
