# Use the reviewed mobile/dist build; no Node.js image is required on the server.
ARG PYTHON_BASE=python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
FROM ${PYTHON_BASE} AS runtime
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src PIP_INDEX_URL=${PIP_INDEX_URL}
WORKDIR /app
COPY pyproject.toml README.md ./
RUN python -c "import tomllib,subprocess; p=tomllib.load(open('pyproject.toml','rb'))['project']; d=[x for x in p['dependencies'] if not x.startswith('streamlit')]+p['optional-dependencies']['mobile']; subprocess.run(['pip','install','--no-cache-dir',*d],check=True)" \
    && useradd --uid 10001 --create-home xiaoli
COPY src ./src
COPY knowledge ./knowledge
COPY mobile/dist ./mobile/dist
RUN chmod -R a+rX /app/src /app/knowledge /app/mobile/dist \
    && mkdir -p /app/data && chown xiaoli:xiaoli /app/data
USER xiaoli
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
CMD ["uvicorn", "camera_assistant.web_app:from_env", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--no-proxy-headers"]
