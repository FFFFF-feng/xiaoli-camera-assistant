# 复制为 deploy/.env；该文件不会打包进镜像或提交 Git。
XIAOLI_DOMAIN=photo.example.com
WEB_ORIGIN=https://photo.example.com
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_TRUSTED_PROXY_IP=172.30.71.2

# 第一轮无密钥验收使用规则演示。
APP_DEMO_MODE=true
# 规则演示与真实模型均由网页自动建立签名会话。
CAMERA_AI_COMPOSITION_ENABLED=true
CAMERA_AI_DETECTOR_ENABLED=false
CAMERA_AI_PRESET=custom
CAMERA_AI_API_KEY=
CAMERA_AI_BASE_URL=
CAMERA_AI_VISION_MODEL=
CAMERA_AI_TEXT_MODEL=
CAMERA_AI_TIMEOUT_SECONDS=120
CAMERA_AI_MAX_IMAGE_MB=15
KNOWLEDGE_RETRIEVAL_MODE=legacy
KNOWLEDGE_DB_PATH=data/knowledge.db
